{
  "name": "@bnb/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The shared design system: theme tokens for each site and the Svelte components they're built from.",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./base.css": "./src/lib/base.css",
    "./themes/*.css": "./src/lib/themes/*.css",
    "./*.svelte": {
      "types": "./src/lib/*.svelte",
      "svelte": "./src/lib/*.svelte",
      "default": "./src/lib/*.svelte"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest",
    "test:coverage": "vitest --run --coverage"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "playwright": "^1.64.1",
    "storybook": "^10.6.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  }
}
