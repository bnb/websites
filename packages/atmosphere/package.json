{
  "name": "@bnb/atmosphere",
  "version": "0.0.0",
  "private": true,
  "description": "The sites' browser client for the Atmosphere: ATProto OAuth sign-in, writing records to a reader's repo, and reads from Constellation and Slingshot.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./oauth": "./src/oauth.ts",
    "./testing/*": "./src/testing/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test:unit": "vitest",
    "test:coverage": "vitest --run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.9"
  }
}
