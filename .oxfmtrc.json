{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"ignorePatterns": [
		"node_modules/",
		"build/",
		".svelte-kit/",
		".claude/",
		".cache/",
		"storybook-static/",
		"coverage/",
		"playwright-report/",
		"test-results/",
		"lighthouse-report/",
		".lighthouseci/",
		"package.json",
		"dist/",
		"package-lock.json",
		"*.md"
	]
}
