{
  "name": "bnb.im",
  "version": "1.0.0",
  "private": true,
  "description": "Tierney Cyren's blog: open source, JavaScript, Node.js, standards and the AT Protocol. Prerendered to static files for GitHub Pages.",
  "type": "module",
  "license": "MIT",
  "author": "Tierney Cyren <hello@bnb.im> (https://bnb.im/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnb/bnb.im.git"
  },
  "scripts": {
    "dev": "vite dev --port 5174 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 4174 --host 127.0.0.1",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:unit": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.test.ts",
    "lighthouse": "npm run build && npx --yes @lhci/cli@0.15.1 autorun",
    "publish": "node scripts/publish.js",
    "predev": "npm run build -w @bnb/standard-site",
    "prebuild": "npm run build -w @bnb/standard-site"
  },
  "dependencies": {
    "@bnb/ui": "*",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@bnb/atproto": "^0.0.0",
    "@bnb/kit": "*",
    "@bnb/standard-site": "*",
    "@bnb/testing": "*",
    "@fontsource/archivo-black": "^5.2.0",
    "@fontsource/dm-mono": "^5.2.0",
    "@fontsource/lato": "^5.2.0",
    "@fontsource/playfair-display": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-footnote": "^4.0.0",
    "playwright": "^1.63.0",
    "prismjs": "^1.30.0",
    "satori": "^0.63.2",
    "slugify": "^1.6.9",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "vite": "^8.3.2",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0",
    "yaml": "^2.9.1"
  }
}
