{
  "name": "tierneycyren.com",
  "version": "0.1.0",
  "private": true,
  "description": "tierney cyren, DJ: mixes read live from the AT Protocol (plyr.fm records).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --port 5175",
    "build": "vite build",
    "preview": "vite preview --port 4175",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:unit": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.test.ts",
    "lighthouse": "npm run build && npx --yes @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@bnb/atproto": "*",
    "@bnb/kit": "*",
    "@bnb/ui": "*",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "evlog": "^2.32.0",
    "satori": "^0.33.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@bnb/testing": "*",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  }
}
