{
  "name": "styleguide",
  "version": "0.0.0",
  "private": true,
  "description": "The styleguide: Storybook for the shared design system and every site's components, each story checked with axe.",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest --run"
  },
  "devDependencies": {
    "@bnb/ui": "*",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.2.0",
    "@fontsource/dm-mono": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/sveltekit": "^10.6.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  }
}
